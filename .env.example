# App
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
API_INTERNAL_URL=http://api:8787
NODE_ENV=development

# Database (inside Docker Compose)
DATABASE_URL=postgres://t1:t1@db:5432/t1

# Agent auth.md registration
AGENT_AUTH_SECRET=dev-only-change-me
# Optional: require x-bootstrap-token for POST /agent/identity
AGENT_REGISTRATION_TOKEN=
AGENT_ACCESS_TOKEN_TTL_SECONDS=3600
AGENT_ASSERTION_TTL_SECONDS=86400

# Security
SESSION_SECRET=dev-only-change-me
IP_HASH_SECRET=dev-only-change-me
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limits
PASTE_MAX_BYTES=262144
PASTE_DEFAULT_TTL_SECONDS=604800
PASTE_MAX_TTL_SECONDS=2592000

# Admin
ADMIN_EMAILS=you@example.com
