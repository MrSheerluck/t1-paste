{
  "name": "t1-paste",
  "version": "0.0.0",
  "private": true,
  "description": "A free, open-source, agent-first pastebin.",
  "homepage": "https://paste.transistorone.com",
  "bugs": {
    "url": "https://github.com/MrSheerluck/t1-paste/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrSheerluck/t1-paste.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp run website#dev",
    "check": "vp check",
    "typecheck": "tsc --noEmit -p packages/shared/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json && tsc --noEmit -p packages/emails/tsconfig.json && tsc --noEmit -p packages/sdk/tsconfig.json && tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "pnpm run test:packages && pnpm run test:api",
    "test:packages": "pnpm --filter @t1/shared test && pnpm --filter utils test",
    "test:api": "vp test apps/api/tests",
    "build": "pnpm --filter @t1/web build",
    "ready": "vp check && pnpm run typecheck && pnpm run test && pnpm run build",
    "prepare": "vp config",
    "db:generate": "pnpm --filter @t1/db generate",
    "db:migrate": "pnpm --filter @t1/db migrate",
    "db:seed": "pnpm --filter @t1/db seed",
    "db:studio": "pnpm --filter @t1/db studio"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
